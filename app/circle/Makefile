# app/circle/Makefile — builds kernel8-rpi4.img with Circle.
# Use tools/build-pi.sh rather than calling this directly: it configures
# Circle (AArch64, RASPPI=4) and builds the Circle libraries first.

CIRCLEHOME = ../../third_party/circle

# Portable code shared with the Linux test build: the whole emulator core
# and the platform-independent front-end code.
CORE_SRCS	:= $(shell find ../../core -name '*.cpp' | sort)
PORTABLE_OBJS	= $(CORE_SRCS:.cpp=.o) \
		  $(patsubst %.cpp,%.o,$(sort $(wildcard ../../platform/common/*.cpp)))

# ndrv_data.cpp is generated by tools/build-pi.sh (our display driver).
OBJS	= main.o kernel.o teedevice.o settings.o mac_host.o web.o ndrv_data.o $(PORTABLE_OBJS)

LIBS	= $(CIRCLEHOME)/addon/fatfs/libfatfs.a \
	  $(CIRCLEHOME)/addon/SDCard/libsdcard.a \
	  $(CIRCLEHOME)/lib/usb/libusb.a \
	  $(CIRCLEHOME)/lib/input/libinput.a \
	  $(CIRCLEHOME)/lib/fs/libfs.a \
	  $(CIRCLEHOME)/lib/sound/libsound.a \
	  $(CIRCLEHOME)/lib/net/libnet.a \
	  $(CIRCLEHOME)/lib/sched/libsched.a \
	  $(CIRCLEHOME)/lib/libcircle.a

# The portable core is included as "core/..." / "platform/..." from the repo root.
EXTRAINCLUDE = -I ../..

# Warnings are errors for our code (a Circle macro clash was once only a warning).
WARNINGS = -Wall -Werror

G3_GIT_REV := $(shell git describe --always --dirty 2>/dev/null || echo unknown)
DEFINE	+= -DG3_GIT_REV=\"$(G3_GIT_REV)\"
# Extra defines for test builds, e.g. G3_DEFINES=-DG3_QEMU_DRAWTEST (docs/devlog).
DEFINE	+= $(G3_DEFINES)

include $(CIRCLEHOME)/Rules.mk

-include $(DEPS)
