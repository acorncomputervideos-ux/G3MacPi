// Assembler cases: GNU-assembler text and the Assembler call that must
// produce the same first word. tools/jit/a64_vectors.sh assembles the text
// into a64_golden.inc. Branch texts use "." = the compared word (the
// first, unless the case sets `at`).
CASE("movz w3, #0x1234", a.movz(false, X3, 0x1234, 0))
CASE("movz w0, #0xffff, lsl #16", a.movz(false, X0, 0xFFFF, 16))
CASE("movz x17, #0xbeef, lsl #48", a.movz(true, X17, 0xBEEF, 48))
CASE("movz x9, #0x1, lsl #32", a.movz(true, X9, 1, 32))
CASE("movk w30, #0x8001, lsl #16", a.movk(false, X30, 0x8001, 16))
CASE("movk x16, #0xabcd, lsl #32", a.movk(true, X16, 0xABCD, 32))
CASE("movk x16, #0x7, lsl #48", a.movk(true, X16, 7, 48))
CASE("movn w9, #0x0", a.movn(false, X9, 0, 0))
CASE("movn w9, #0x1234, lsl #16", a.movn(false, X9, 0x1234, 16))
CASE("movn x2, #0x5", a.movn(true, X2, 5, 0))
CASE("mov w8, w21", a.mov(false, X8, X21))
CASE("mov x19, x0", a.mov(true, X19, X0))
CASE("mov x29, sp", a.mov_from_sp(X29))
CASE("add w8, w9, #0xfff", a.add_imm(false, X8, X9, 0xFFF))
CASE("add x20, x19, #0x10", a.add_imm(true, X20, X19, 0x10))
CASE("add x17, x19, #0x3, lsl #12", a.add_imm(true, X17, X19, 3, true))
CASE("add x9, x9, #0x1", a.add_imm(true, X9, X9, 1))
CASE("sub w8, w8, #0x4", a.sub_imm(false, X8, X8, 4))
CASE("sub x1, x2, #0x7ff, lsl #12", a.sub_imm(true, X1, X2, 0x7FF, true))
CASE("add w8, w9, w10", a.add(false, X8, X9, X10))
CASE("add x0, x30, x15", a.add(true, X0, X30, X15))
CASE("sub w8, w10, w9", a.sub(false, X8, X10, X9))
CASE("sub x3, x4, x5", a.sub(true, X3, X4, X5))
CASE("and w8, w8, w9", a.and_(false, X8, X8, X9))
CASE("and x1, x2, x3", a.and_(true, X1, X2, X3))
CASE("orr w12, w13, w14", a.orr(false, X12, X13, X14))
CASE("orr x5, x6, x7", a.orr(true, X5, X6, X7))
CASE("eor w8, w8, w9", a.eor(false, X8, X8, X9))
CASE("eor x30, x29, x28", a.eor(true, X30, X29, X28))
