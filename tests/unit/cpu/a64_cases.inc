CASE("extr w8, w8, w8, #0x1f", a.extr(false, X8, X8, X8, 31))
CASE("extr x1, x2, x3, #0x3f", a.extr(true, X1, X2, X3, 63))
CASE("ror w8, w8, #0x10", a.ror_imm(X8, X8, 16))
CASE("ldr w8, [x20]", a.ldr(false, X8, X20, 0))
CASE("ldr w8, [x20, #0x7c]", a.ldr(false, X8, X20, 0x7C))
CASE("ldr w0, [x1, #0x3ffc]", a.ldr(false, X0, X1, 0x3FFC))
CASE("ldr x9, [x19, #0x7ff8]", a.ldr(true, X9, X19, 0x7FF8))
CASE("ldr x30, [sp, #0x8]", a.ldr(true, X30, SP, 8))
CASE("str w8, [x20, #0x184]", a.str(false, X8, X20, 0x184))
CASE("str w0, [x1, #0x3ffc]", a.str(false, X0, X1, 0x3FFC))
