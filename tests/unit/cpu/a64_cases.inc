CASE("blr x16", a.blr(X16))
CASE("blr x0", a.blr(X0))
CASE("ret", a.ret())
CASE("br x16", a.br(X16))
CASE("br x12", a.br(X12))
CASE("nop", a.nop())
CASE("cbnz w8, .+12", { Assembler::Label l; a.cbnz(false, X8, l); a.nop(); a.nop(); a.bind(l); })
CASE("cbnz x0, .+0x40000", { Assembler::Label l; a.cbnz(true, X0, l); for (u32 k = 1; k < 0x10000; ++k) a.nop(); a.bind(l); })
CASE("cbnz w3, .-8", { a.nop(); a.nop(); Assembler::Label l; a.bind(l); a.nop(); a.nop(); at = a.size(); a.cbnz(false, X3, l); a.nop(); })
CASE("b .+0x1000", { Assembler::Label l; a.b(l); for (u32 k = 1; k < 0x400; ++k) a.nop(); a.bind(l); })
CASE("add x12, x9, x9, lsl #1", a.add(true, X12, X9, X9, 1))
CASE("add x12, x24, x12, lsl #2", a.add(true, X12, X24, X12, 2))
CASE("sub w1, w2, w3, lsl #31", a.sub(false, X1, X2, X3, 31))
CASE("orr w14, w14, w11, lsl #1", a.orr(false, X14, X14, X11, 1))
CASE("and x5, x6, x7, lsl #63", a.and_(true, X5, X6, X7, 63))
CASE("eor w8, w9, w10, lsl #4", a.eor(false, X8, X9, X10, 4))
CASE("cmp w13, w14", a.cmp(false, X13, X14))
CASE("cmp x1, x30", a.cmp(true, X1, X30))
CASE("cmp w9, #0xffc", a.cmp_imm(false, X9, 0xFFC))
CASE("cmp x0, #0x0", a.cmp_imm(true, X0, 0))
CASE("lsr w11, w8, #12", a.lsr_imm(X11, X8, 12))
CASE("ubfx w9, w11, #0, #8", a.ubfx(X9, X11, 0, 8))
CASE("ubfx w14, w10, #14, #1", a.ubfx(X14, X10, 14, 1))
CASE("ubfx w9, w8, #0, #12", a.ubfx(X9, X8, 0, 12))
CASE("ubfm x1, x2, #0x3, #0x3e", a.ubfm(true, X1, X2, 3, 62))
CASE("ubfm w1, w2, #0x1f, #0x1e", a.ubfm(false, X1, X2, 31, 30))
CASE("rev w10, w10", a.rev(X10, X10))
CASE("rev w0, w30", a.rev(X0, X30))
CASE("rev16 w10, w11", a.rev16(X10, X11))
CASE("ldr w10, [x22, x9]", a.ldr_reg(4, X10, X22, X9))
CASE("str w10, [x22, x9]", a.str_reg(4, X10, X22, X9))
CASE("ldrh w10, [x22, x9]", a.ldr_reg(2, X10, X22, X9))
CASE("strh w3, [x4, x5]", a.str_reg(2, X3, X4, X5))
CASE("ldrb w10, [x22, x9]", a.ldr_reg(1, X10, X22, X9))
CASE("strb w0, [sp, x1]", a.str_reg(1, X0, SP, X1))
CASE("ldrb w9, [x23, x9]", a.ldr_reg(1, X9, X23, X9))
CASE("cbz w13, .+16", { Assembler::Label l; a.cbz(false, X13, l); a.nop(); a.nop(); a.nop(); a.bind(l); })
CASE("cbz x2, .-4", { a.nop(); Assembler::Label l; a.bind(l); a.nop(); at = a.size(); a.cbz(true, X2, l); })
CASE("tbz w10, #4, .+8", { Assembler::Label l; a.tbz(X10, 4, l); a.nop(); a.bind(l); })
CASE("tbnz w10, #31, .+0x7ffc", { Assembler::Label l; a.tbnz(X10, 31, l); for (u32 k = 1; k < 0x1FFF; ++k) a.nop(); a.bind(l); })
CASE("tbz x3, #40, .-0x8000", { Assembler::Label l; a.bind(l); for (u32 k = 0; k < 0x2000; ++k) a.nop(); at = a.size(); a.tbz(X3, 40, l); })
CASE("b.ne .+20", { Assembler::Label l; a.b_cond(Assembler::NE, l); for (u32 k = 1; k < 5; ++k) a.nop(); a.bind(l); })
CASE("b.hi .+8", { Assembler::Label l; a.b_cond(Assembler::HI, l); a.nop(); a.bind(l); })
CASE("b.eq .-12", { Assembler::Label l; a.bind(l); a.nop(); a.nop(); a.nop(); at = a.size(); a.b_cond(Assembler::EQ, l); })
CASE("b.le .+0x100000-4", { Assembler::Label l; a.b_cond(Assembler::LE, l); for (u32 k = 1; k < 0x3FFFF; ++k) a.nop(); a.bind(l); })
