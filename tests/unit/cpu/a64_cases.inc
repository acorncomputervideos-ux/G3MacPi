CASE("stp x29, x30, [sp, #-48]!", a.stp_pre(X29, X30, SP, -48))
CASE("stp x29, x30, [sp, #-512]!", a.stp_pre(X29, X30, SP, -512))
CASE("stp x19, x20, [sp, #16]", a.stp(X19, X20, SP, 16))
CASE("stp x21, x22, [sp, #504]", a.stp(X21, X22, SP, 504))
CASE("ldp x19, x20, [sp, #16]", a.ldp(X19, X20, SP, 16))
